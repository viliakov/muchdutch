  "rate": "+0%",
  "seed": 274052483904870761,
  "items": [
    {
      "number": 1,
      "text": "Op de eerste zondag van de maand gaan we bij opa op bezoek.",
      "voice": "nl-NL-ColetteNeural",
      "file": "01.mp3"
    },
    {
      "number": 2,
      "text": "In de winter dragen sommige kinderen twee truien.",
      "voice": "nl-NL-FennaNeural",
      "file": "02.mp3"
    },
    {
      "number": 3,
      "text": "Op vijf december nemen bijna alle ouders iets voor hun kinderen mee.",
      "voice": "nl-NL-FennaNeural",
      "file": "03.mp3"
    },
    {
      "number": 4,
      "text": "Ik blijf thuis omdat mijn dochter vandaag zwemles heeft.",
      "voice": "nl-NL-ColetteNeural",
      "file": "04.mp3"
    },
    {
      "number": 5,
      "text": "Als het sneeuwt, zetten we de auto voor het huis.",
      "voice": "nl-NL-ColetteNeural",
      "file": "05.mp3"
    },
    {
      "number": 6,
      "text": "Toen de les begon, zat ik al in de klas.",
      "voice": "nl-BE-DenaNeural",
      "file": "06.mp3"
    },
    {
      "number": 7,
      "text": "Eerst speelde ik buiten en toen schreef ik een bericht.",
      "voice": "nl-BE-ArnaudNeural",
      "file": "07.mp3"
    },
    {
      "number": 8,
      "text": "Ik kwam toen elke dag vroeg thuis.",
      "voice": "nl-BE-ArnaudNeural",
      "file": "08.mp3"
    },
    {
      "number": 9,
      "text": "Gisteren hebben we met de buurvrouw over kerst gesproken.",
      "voice": "nl-BE-DenaNeural",
      "file": "09.mp3"
    },
    {
      "number": 10,
      "text": "Bij het zebrapad moet je goed naar links kijken.",
      "voice": "nl-BE-DenaNeural",
      "file": "10.mp3"
    },
    {
      "number": 11,
      "text": "Ik hoef mijn jas niet mee te nemen.",
      "voice": "nl-NL-ColetteNeural",
      "file": "11.mp3"
    },
    {
      "number": 12,
      "text": "Zal ik vanavond de lampjes in de boom hangen?",
      "voice": "nl-BE-ArnaudNeural",
      "file": "12.mp3"
    },
    {
      "number": 13,
      "text": "Wij wassen ons snel om op tijd te vertrekken.",
      "voice": "nl-NL-MaartenNeural",
      "file": "13.mp3"
    },
    {
      "number": 14,
      "text": "Morgen zal mijn zus drie dozen naar oma brengen.",
      "voice": "nl-NL-FennaNeural",
      "file": "14.mp3"
    },
    {
      "number": 15,
      "text": "De meeste gasten komen om kwart over zes.",
      "voice": "nl-NL-MaartenNeural",
      "file": "15.mp3"
    },
    {
      "number": 16,
      "text": "We nemen geen lunchpakket mee naar het feest.",
      "voice": "nl-NL-FennaNeural",
      "file": "16.mp3"
    },
    {
      "number": 17,
      "text": "We eten vroeg, want de trein vertrekt om zeven uur.",
      "voice": "nl-NL-MaartenNeural",
      "file": "17.mp3"
    },
    {
      "number": 18,
      "text": "Wil je naar de kerk of blijf je thuis?",
      "voice": "nl-NL-MaartenNeural",
      "file": "18.mp3"
    },
    {
      "number": 19,
      "text": "Ik draag graag oranje, maar mijn broer draagt liever blauw.",
      "voice": "nl-BE-ArnaudNeural",
      "file": "19.mp3"
    },
    {
      "number": 20,
      "text": "Mijn broer neemt nooit een paraplu mee.",
      "voice": "nl-BE-DenaNeural",
      "file": "20.mp3"
    }
  ]
}
